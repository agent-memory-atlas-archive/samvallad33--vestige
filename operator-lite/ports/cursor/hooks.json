{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "python3 REPLACE_WITH_HOME/.operator/gate/cursor-hook.py",
        "timeout": 10,
        "failClosed": true,
        "matcher": "*"
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "python3 REPLACE_WITH_HOME/.operator/gate/cursor-hook.py",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": "python3 REPLACE_WITH_HOME/.operator/gate/cursor-hook.py",
        "timeout": 10,
        "failClosed": true,
        "matcher": "^(Write|Edit|MultiEdit|Delete|NotebookEdit)$"
      }
    ]
  }
}
