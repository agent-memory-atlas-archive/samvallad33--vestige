#!/usr/bin/env node
/**
 * Vestige Operator Lite -- Cline PreToolUse hook
 *
 * Cline (v3.36+) discovers executable hook files named after the event
 * (PreToolUse, no extension or .sh/.py/.js/...) in:
 *     ~/.cline/hooks/                  (global, SDK-native; $CLINE_DIR/hooks)
 *     ~/Documents/Cline/Hooks/         (global, VS Code Rules tab)
 *     <workspace>/.cline/hooks/        (project)
 *     <workspace>/.clinerules/hooks/   (project, deprecated)
 * and runs them as a subprocess with JSON on stdin before every tool call --
 * BEFORE tool policies and BEFORE user approval, so the gate also covers
 * auto-approved ("YOLO") calls. (Verified against cline/cline source:
 *   sdk/packages/shared/src/storage/paths.ts          -- search paths
 *   sdk/packages/core/src/hooks/hook-file-config.ts   -- file names
 *   sdk/packages/core/src/hooks/hook-file-hooks.ts    -- stdin payload
 *   sdk/packages/core/src/hooks/subprocess.ts         -- stdout control JSON
 *   sdk/packages/agents/src/agent-runtime.ts          -- hooks run before approval)
 *
 * stdin (both shapes are sent by Cline; we read both):
 *   { hookName: "tool_call",
 *     tool_call:  { id, name, input },                        // raw input object
 *     preToolUse: { toolName, parameters },                   // stringified values
 *     workspaceRoots: ["/..."], taskId, clineVersion, ... }
 *
 * stdout (the only channel that matters -- exit codes are NOT the protocol,
 * so this script always exits 0):
 *   {}                                        -> allow
 *   {"cancel": true, "errorMessage": "..."}   -> block; Cline stops the run and
 *                                                surfaces errorMessage as the reason
 *
 * The gate (one stdlib-only Python file) classifies; it never executes what it
 * inspects. Node builtins only -- no npm dependencies.
 */
"use strict";

const { spawn } = require("node:child_process");
const { homedir } = require("node:os");
const { join } = require("node:path");

const GATE_TIMEOUT_MS = 8000; // Cline's own tool-hook ceiling is 120s
const MAX_REASON = 2000;

const GATE =
  process.env.OPERATOR_GATE_PY ||
  join(
    process.env.OPERATOR_HOME || join(homedir(), ".operator"),
    "gate",
    "operator-gate.py",
  );

// Fail-closed fallback for plainly destructive text when the gate itself is
// unreachable (missing python3, crashed gate). Mirrors the OpenClaw adapter.
const DESTRUCTIVE_LIKE =
  /\brm\s+-[a-zA-Z]*[rR]|\bmv\s+\S*(vestige|Developer|\.zcode|\.claude)|\bpush\b.*--force|\bDROP\s+TABLE|\.vestige[/\\]vestige\.db|fly\s+deploy|mkfs|\bdd\s+if=|OPERATOR_CANARY_STOP_7f3a/i;

// Cline tool names the gate has rules for. The gate is never modified; we
// normalize Cline names onto the gate's tool vocabulary adapter-side.
//   run_commands      -> passed as-is (the gate classifies any tool whose
//                        input carries a "command" key as shell)
//   write_to_file     -> write_file   (gate WRITE_TOOLS; reads path/content)
//   apply_diff / replace_in_file / search_and_replace / insert_content
//                     -> edit        (gate WRITE_TOOLS; reads path)
//   use_mcp_tool      -> mcp__use_mcp_tool (gate MCP branch: secret-shaped
//                        arguments, sensitive-path arguments)
// Everything else (read_files, list_files, search_files, ask_followup_question,
// attempt_completion, ...) has no gate rules -- allow without spawning Python.
const TOOL_MAP = {
  write_to_file: "write_file",
  apply_diff: "edit",
  replace_in_file: "edit",
  search_and_replace: "edit",
  insert_content: "edit",
  use_mcp_tool: "mcp__use_mcp_tool",
};

function log(msg) {
  process.stderr.write(`[operator-gate] ${msg}\n`);
}

function allow() {
  process.stdout.write("{}\n");
}

function block(reason) {
  process.stdout.write(
    JSON.stringify({ cancel: true, errorMessage: String(reason).slice(0, MAX_REASON) }) + "\n",
  );
}

// run_commands input comes as string | string[] | { command | commands | cmd }
// (same shapes the official env-blocker example normalizes).
function extractCommands(input) {
  if (input == null) return [];
  if (typeof input === "string") return [input];
  if (Array.isArray(input)) return input.filter((c) => typeof c === "string");
  if (typeof input === "object") {
    const v = input.command ?? input.commands ?? input.cmd;
    if (typeof v === "string") return [v];
    if (Array.isArray(v)) return v.filter((c) => typeof c === "string");
  }
  return [];
}

function runGate(payload) {
  return new Promise((resolve) => {
    let settled = false;
    const done = (r) => {
      if (!settled) {
        settled = true;
        resolve(r);
      }
    };
    let child;
    try {
      child = spawn(process.env.OPERATOR_PYTHON || "python3", [GATE, "hook", "--source", "cline"], {
        env: { ...process.env, OPERATOR_AGENT_SESSION: "1" },
        stdio: ["pipe", "ignore", "pipe"],
      });
    } catch (err) {
      return done({ ok: false, err: String(err) });
    }
    let stderr = "";
    child.stderr?.on("data", (d) => {
      stderr += d.toString();
    });
    const timer = setTimeout(() => {
      try {
        child.kill("SIGKILL");
      } catch {}
      done({ ok: false, err: "gate timeout" });
    }, GATE_TIMEOUT_MS);
    child.on("error", (err) => {
      clearTimeout(timer);
      done({ ok: false, err: String(err) });
    });
    child.on("close", (code) => {
      clearTimeout(timer);
      done({ ok: true, code: code ?? 1, reason: stderr.trim() });
    });
    try {
      child.stdin.write(JSON.stringify(payload));
      child.stdin.end();
    } catch (err) {
      clearTimeout(timer);
      done({ ok: false, err: String(err) });
    }
  });
}

async function main() {
  let raw = "";
  process.stdin.setEncoding("utf8");
  for await (const chunk of process.stdin) raw += chunk;

  let event;
  try {
    event = JSON.parse(raw || "{}");
  } catch (err) {
    log(`unparseable hook input, allowing (${String(err).slice(0, 120)})`);
    return allow();
  }

  const toolCall = event.tool_call ?? {};
  const pre = event.preToolUse ?? {};
  const toolRaw = String(toolCall.name ?? pre.toolName ?? "").trim();
  if (!toolRaw) return allow();

  // tool_call.input is the raw object; preToolUse.parameters is the same data
  // with every value stringified. Prefer the raw object.
  let input = toolCall.input;
  if (input == null && pre.parameters && typeof pre.parameters === "object") {
    input = pre.parameters;
  }

  const mapped = TOOL_MAP[toolRaw];
  const isShell = !mapped && extractCommands(input).length > 0;
  if (!mapped && !isShell) return allow(); // no gate rules for this tool

  const gateTool = isShell ? toolRaw : mapped;

  // Normalize the gate payload. Shell: one command string (multi-command
  // inputs are newline-joined; the gate's segment walker handles newlines and
  // tracks cd/vars across segments). Write/MCP: pass the input object through.
  let toolInput;
  if (isShell) {
    toolInput = { command: extractCommands(input).join("\n") };
  } else if (input && typeof input === "object" && !Array.isArray(input)) {
    toolInput = input;
  } else {
    toolInput = { command: String(input ?? "") };
  }

  const commandText = isShell ? toolInput.command : JSON.stringify(toolInput);

  const payload = {
    tool_name: gateTool,
    tool_input: toolInput,
    cwd: (Array.isArray(event.workspaceRoots) && event.workspaceRoots[0]) || process.cwd(),
    session_id: event.taskId ?? undefined,
  };

  const res = await runGate(payload);
  if (res.ok && res.code === 0) return allow();
  if (res.ok && res.code === 2) {
    log(`STOP -> ${String(commandText).slice(0, 160)}`);
    return block(res.reason || "OPERATOR: STOPPED");
  }

  // Gate unreachable: fail open, unless the text plainly looks destructive.
  if (DESTRUCTIVE_LIKE.test(String(commandText))) {
    log(`UNREACHABLE and the call looks destructive -- blocking (${res.err})`);
    return block(
      "OPERATOR: STOPPED (degraded) -- the gate is unreachable and this call looks destructive. " +
        `Ask the owner. (${res.err})`,
    );
  }
  log(`unreachable, failing open (${res.err})`);
  return allow();
}

main().catch((err) => {
  // Belt and braces: an adapter defect must never wedge Cline. Fail open with
  // a note, unless the (unavailable) command text plainly looked destructive.
  log(`adapter error, failing open (${String(err && err.stack ? err.stack : err).slice(0, 300)})`);
  allow();
});
